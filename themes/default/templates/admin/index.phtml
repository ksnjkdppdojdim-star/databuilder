<?php
/**
 * DataBuilder Admin Index Template
 *
 * Renders the admin dashboard with statistics cards and traffic information.
 * This template can be completely overridden in themes/custom/templates/admin/index.phtml
 * 
 * Variables available:
 * - $statistics: Array of admin statistics with icons and values
 * - $traffic: Array with traffic percentage and warning
 * - $block: The IndexBlock instance for accessing block methods
 * - $assetManager: The AssetManager instance for injecting assets
 *
 * @var \DataBuilder\Block\Admin\IndexBlock $block
 * @var \DataBuilder\Asset\AssetManager $assetManager
 */

// Ensure asset manager is available
$assetManager = $assetManager ?? new \DataBuilder\Asset\AssetManager(
    $this->getRegistry()->get('config', [])
);

// Add default DataBuilder assets
$assetManager->addDefaultAdminAssets();

// Inject CSS in the document head (can be captured by wrapper layout)
if (method_exists($this, 'injectAssets')) {
    $this->injectAssets($assetManager);
}
?>

<div class="databuilder-admin-index" data-theme="databuilder" data-page="admin_index">
    
    <!-- Administrative Dashboard Statistics Section -->
    <section class="db-section db-statistics" id="admin-statistics">
        <div class="statistics-grid">
            
            <?php foreach ($this->block->getStatistics() as $stat): ?>
                <!-- Stat Card -->
                <div class="stat-card stat-card--<?php echo $this->escapeHtml($stat['variable']); ?>" 
                     data-stat="<?php echo $this->escapeHtml($stat['variable']); ?>">
                    
                    <div class="stat-card__icon">
                        <!-- Icon will depend on stat type - customizable in data XML -->
                    </div>
                    
                    <div class="stat-card__content">
                        <div class="stat-card__value">
                            <?php echo $this->escapeHtml($stat['value']); ?>
                        </div>
                        <div class="stat-card__label">
                            <!-- Translation key will be replaced by iMSCP -->
                            {<?php echo $stat['label_key']; ?>}
                        </div>
                    </div>
                </div>
            <?php endforeach; ?>
            
        </div>
    </section>

    <!-- Server Traffic Section -->
    <section class="db-section db-traffic" id="admin-traffic">
        <div class="traffic-container">
            <div class="traffic-header">
                <h3 class="traffic-title">
                    <span class="material-symbols-outlined">cloud_download</span>
                    {<?php echo $this->block->getTraffic()['label']; ?>}
