<?xml version="1.0" encoding="UTF-8"?>
<layout>
    <!-- Server Statistic Page Layout - Custom Theme Override -->
    
    <!-- Root Block - Main Container -->
    <block name="root" class="DataBuilder\Block\ContainerBlock" htmlTag="div" htmlClass="databuilder-server-stats">
        
        <!-- Header Block -->
        <block name="header" class="DataBuilder\Block\ContainerBlock" template="admin/server_statistic/header.phtml" htmlTag="div" htmlClass="page-header"/>
        
        <!-- Filter Bar Block -->
        <block name="filter_bar" class="DataBuilder\Block\ContainerBlock" template="admin/server_statistic/filter_bar.phtml" htmlTag="div" htmlClass="filter-bar"/>
        
        <!-- Content Block -->
        <block name="content" class="DataBuilder\Block\ContainerBlock" htmlTag="div" htmlClass="content">
            
            <!-- Service Summary Cards -->
            <block name="service_summary" class="DataBuilder\Block\ContainerBlock" template="admin/server_statistic/service_summary.phtml" htmlTag="div" htmlClass="service-summary"/>
            
            <!-- Total Traffic Block -->
            <block name="total_traffic" class="DataBuilder\Block\ContainerBlock" template="admin/server_statistic/total_traffic.phtml" htmlTag="div" htmlClass="total-traffic"/>
            
            <!-- Stats Table Block -->
            <block name="stats_table" class="DataBuilder\Block\ContainerBlock" template="admin/server_statistic/stats_table.phtml" htmlTag="div" htmlClass="stats-table-container"/>
            
        </block>
        
        <!-- Footer Block -->
        <block name="footer" class="DataBuilder\Block\ContainerBlock" template="admin/server_statistic/footer.phtml" htmlTag="div" htmlClass="page-footer"/>
        
    </block>
</layout>

