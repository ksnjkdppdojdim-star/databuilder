<?php
/**
 * DataBuilder Stat Card Block Template
 * 
 * A reusable stat card block with icon, value, and label
 */

// Get block parameters
$label = $this->getParam('label', '');
$value = $this->getParam('value', '0');
$icon = $this->getParam('icon', 'analytics');
$color = $this->getParam('color', 'blue');
$span = $this->getParam('span', '2');

// Color mapping to CSS classes
$colorClasses = [
    'blue' => 'bg-blue-50 dark:bg-blue-500/10 text-blue-500',
    'emerald' => 'bg-emerald-50 dark:bg-emerald-500/10 text-emerald-500',
    'amber' => 'bg-amber-50 dark:bg-amber-500/10 text-amber-500',
    'purple' => 'bg-purple-50 dark:bg-purple-500/10 text-purple-500',
    'cyan' => 'bg-cyan-50 dark:bg-cyan-500/10 text-cyan-500',
    'indigo' => 'bg-indigo-50 dark:bg-indigo-500/10 text-indigo-500',
    'orange' => 'bg-orange-50 dark:bg-orange-500/10 text-orange-500',
    'red' => 'bg-red-50 dark:bg-red-500/10 text-red-500',
];

$bgClass = $colorClasses[$color] ?? $colorClasses['blue'];
?>

<div class="bg-white dark:bg-[#1a222f] p-6 rounded-xl border border-slate-200 dark:border-slate-800 hover:border-primary/40 transition-all shadow-sm lg:col-span-<?php echo $span; ?>">
    <div class="flex items-center justify-between">
        <div>
            <div class="text-3xl font-black text-slate-900 dark:text-white"><?php echo $value; ?></div>
            <div class="text-xs font-semibold text-slate-500 dark:text-[#9ca8ba] uppercase tracking-widest mt-2"><?php echo $label; ?></div>
        </div>
        <div class="w-12 h-12 <?php echo $bgClass; ?> rounded-xl flex items-center justify-center">
            <span class="material-symbols-outlined text-2xl"><?php echo $icon; ?></span>
        </div>
    </div>
</div>

