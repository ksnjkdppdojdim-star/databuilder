$pop_out_all  = $block->getData('POP_OUT_ALL',  '0 B');
$other_in_all  = $block->getData('OTHER_IN_ALL',  '0 B');
$other_out_all = $block->getData('OTHER_OUT_ALL', '0 B');
$all_in_all   = $block->getData('ALL_IN_ALL',   '0 B');
$all_out_all  = $block->getData('ALL_OUT_ALL',  '0 B');
$all_all      = $block->getData('ALL_ALL',      '0 B');
?>
<div class="stats-table-container">
    <h3><?= $block->e($block->getData('TR_MONTHLY_STATS', 'Monthly Statistics')) ?></h3>
    <table class="stats-table monthly">
        <thead>
            <tr>
                <th><?= $block->e($tr_day) ?></th>
                <th><?= $block->e($tr_web_in) ?></th>
                <th><?= $block->e($tr_web_out) ?></th>
                <th><?= $block->e($tr_smtp_in) ?></th>
                <th><?= $block->e($tr_smtp_out) ?></th>
                <th><?= $block->e($tr_pop_in) ?></th>
                <th><?= $block->e($tr_pop_out) ?></th>
                <th><?= $block->e($tr_other_in) ?></th>
                <th><?= $block->e($tr_other_out) ?></th>
                <th><?= $block->e($tr_all_in) ?></th>
                <th><?= $block->e($tr_all_out) ?></th>
                <th><?= $block->e($tr_all) ?></th>
            </tr>
        </thead>
        <tbody>
            <?php if (!empty($server_stats_rows)): ?>
            <?= $server_stats_rows /* pre-rendered HTML from iMSCP parse() loops */ ?>
            <?php else: ?>
            <tr><td colspan="12" style="text-align:center;padding:12px;color:#666;"><!-- DB-DBG:ROWS_EMPTY --></td></tr>
            <?php endif; ?>
        </tbody>
        <tfoot>
            <tr class="totals">
                <td><?= $block->e($tr_all) ?></td>
                <td><?= $block->e($web_in_all) ?></td>
                <td><?= $block->e($web_out_all) ?></td>
                <td><?= $block->e($smtp_in_all) ?></td>
                <td><?= $block->e($smtp_out_all) ?></td>
                <td><?= $block->e($pop_in_all) ?></td>
                <td><?= $block->e($pop_out_all) ?></td>
                <td><?= $block->e($other_in_all) ?></td>
                <td><?= $block->e($other_out_all) ?></td>
                <td><?= $block->e($all_in_all) ?></td>
                <td><?= $block->e($all_out_all) ?></td>
                <td><?= $block->e($all_all) ?></td>
            </tr>
