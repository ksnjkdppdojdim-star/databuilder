<?xml version="1.0" encoding="UTF-8"?>
<layout>
    <container name="root" htmlTag="html">

        <container name="head" htmlTag="head">
            <block
                name="html.head"
                class="DataBuilder\Block\HtmlHeadBlock"
                template="html/head.phtml"
            />
        </container>

        <container name="body" htmlTag="body">

            <container name="header" htmlTag="header">
                <block
                    name="site.header"
                    class="DataBuilder\Block\HeaderBlock"
                    template="blocks/header.phtml"
                />
            </container>

            <container name="main" htmlTag="main">
                <block
                    name="page.content"
                    class="DataBuilder\Block\ContentBlock"
                    template="blocks/content.phtml"
                />
            </container>

            <container name="footer" htmlTag="footer">
                <block
                    name="site.footer"
                    class="DataBuilder\Block\FooterBlock"
                    template="blocks/footer.phtml"
                />
            </container>

        </container>
    </container>
</layout>