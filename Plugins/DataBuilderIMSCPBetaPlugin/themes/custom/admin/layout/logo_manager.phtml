<?php
/**
 * Admin > Layout — Gestionnaire de logo
 * Visible uniquement pour les admins et revendeurs.
 *
 * @var \DataBuilder\Block\ContainerBlock $block
 */
$isAdminReseller = (bool) $block->getData('is_admin_reseller', false);
if (!$isAdminReseller) {
    return; // Pas de section logo pour les clients
}

$hasLogo  = (bool) $block->getData('has_logo',    false);
$ispLogo  = (string) $block->getData('isp_logo',  '');
$trTitle  = (string) $block->getData('tr_logo_file', 'Logo file');
$trUpload = (string) $block->getData('tr_upload',    'Upload');
$trRemove = (string) $block->getData('tr_remove',    'Remove');

$esc = fn(string $s): string => htmlspecialchars($s, ENT_QUOTES, 'UTF-8');
?>
<div class="db-card">
    <div class="db-card-header">
        <h2><?= $esc($trTitle) ?></h2>
    </div>
    <div class="db-card-body">

        <?php if ($hasLogo && $ispLogo !== ''): ?>
        <div class="db-logo-preview">
            <img src="<?= $esc($ispLogo) ?>" alt="ISP Logo" class="db-logo-img">
            <form method="post" action="layout.php" class="db-form db-logo-remove-form">
                <input type="hidden" name="uaction" value="deleteIspLogo">
                <button type="submit" class="db-btn db-btn-danger db-btn-sm">
                    <?= $esc($trRemove) ?>
                </button>
            </form>
        </div>
        <?php endif; ?>

        <form enctype="multipart/form-data" method="post" action="layout.php" class="db-form db-logo-upload-form">
            <div class="db-form-row">
                <label class="db-file-label" for="db-logoFile">
                    <span class="db-file-icon">📁</span>
                    <input type="file" name="logoFile" id="db-logoFile" accept="image/*">
                </label>
            </div>
            <div class="db-form-actions">
                <input type="hidden" name="uaction" value="updateIspLogo">
                <button type="submit" class="db-btn db-btn-primary">
                    <?= $esc($trUpload) ?>
                </button>
            </div>
        </form>

    </div>
</div>
