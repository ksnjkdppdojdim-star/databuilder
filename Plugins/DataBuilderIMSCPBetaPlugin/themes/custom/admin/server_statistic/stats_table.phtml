<?php
/**
 * Server Statistic Page - Stats Table Template
 * 
 * @var $block DataBuilder\Block\ContainerBlock
 */

$tr_day = $block->getData('TR_DAY', 'Day');
$tr_web_in = $block->getData('TR_WEB_IN', 'Web In');
$tr_web_out = $block->getData('TR_WEB_OUT', 'Web Out');
$tr_smtp_in = $block->getData('TR_SMTP_IN', 'SMTP In');
$tr_smtp_out = $block->getData('TR_SMTP_OUT', 'SMTP Out');
$tr_pop_in = $block->getData('TR_POP_IN', 'POP In');
$tr_pop_out = $block->getData('TR_POP_OUT', 'POP Out');
$tr_other_in = $block->getData('TR_OTHER_IN', 'Other In');
$tr_other_out = $block->getData('TR_OTHER_OUT', 'Other Out');
$tr_all_in = $block->getData('TR_ALL_IN', 'Total In');
$tr_all_out = $block->getData('TR_ALL_OUT', 'Total Out');
$tr_all = $block->getData('TR_ALL', 'Total');

// Pre-rendered <tr> rows provided by iMSCP (already formatted, no DB access needed).
$server_stats_rows = $block->getData('SERVER_STATS_ROWS', '');

// Debug log — helps diagnose missing rows on the server
error_log('DataBuilder[stats_table]: SERVER_STATS_ROWS len=' . strlen((string)$server_stats_rows)
    . ' WEB_IN_ALL=' . $block->getData('WEB_IN_ALL', 'missing'));

$web_in_all   = $block->getData('WEB_IN_ALL',   '0 B');
$web_out_all  = $block->getData('WEB_OUT_ALL',  '0 B');
$smtp_in_all  = $block->getData('SMTP_IN_ALL',  '0 B');
$smtp_out_all = $block->getData('SMTP_OUT_ALL', '0 B');
