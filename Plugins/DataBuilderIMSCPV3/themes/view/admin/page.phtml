<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><?php echo $this->escape($this->getVariable('TR_PAGE_TITLE', 'DataBuilder')); ?></title>
    <link rel="stylesheet" href="/gui/themes/default/ui.css">
    <style>
        .databuilder-admin {
            padding: 20px;
        }
        .databuilder-settings {
            background: #fff;
            border: 1px solid #ddd;
            padding: 20px;
            margin-bottom: 20px;
        }
        .databuilder-settings h3 {
            margin-top: 0;
            border-bottom: 1px solid #eee;
            padding-bottom: 10px;
        }
        .form-group {
            margin-bottom: 15px;
        }
        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }
        .form-group select,
        .form-group input[type="text"] {
            width: 100%;
            padding: 8px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }
        .checkbox-group {
            display: flex;
            align-items: center;
        }
        .checkbox-group input {
            margin-right: 10px;
        }
        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
        }
        .btn-primary {
            background: #007bff;
            color: #fff;
        }
        .btn-secondary {
            background: #6c757d;
            color: #fff;
        }
    </style>
</head>
<body>
    <div class="databuilder-admin">
        <h1><?php echo $this->escape($this->getVariable('TR_PAGE_TITLE', 'DataBuilder')); ?></h1>
        
        <?php if ($this->getVariable('page_message')): ?>
        <div class="page_message">
            <?php echo $this->getVariable('page_message'); ?>
        </div>
        <?php endif; ?>
        
        <form method="post" action="">
            <div class="databuilder-settings">
                <h3><?php echo $this->escape($this->getVariable('TR_SETTINGS', 'Settings')); ?></h3>
                
                <div class="form-group">
                    <label for="theme"><?php echo $this->escape($this->getVariable('TR_THEME', 'Theme')); ?></label>
                    <select name="theme" id="theme">
                        <option value="custom" <?php echo $this->getVariable('THEME_SELECTED', ''); ?>>Custom</option>
                        <option value="base" <?php echo $this->getVariable('THEME_BASE_SELECTED', ''); ?>>Base</option>
                    </select>
                </div>
                
                <div class="form-group checkbox-group">
                    <input type="checkbox" name="cache_enabled" id="cache_enabled" <?php echo $this->getVariable('CACHE_CHECKED', 'checked'); ?>>
                    <label for="cache_enabled"><?php echo $this->escape($this->getVariable('TR_CACHE_ENABLED', 'Enable cache')); ?></label>
                </div>
                
                <div class="form-group checkbox-group">
                    <input type="checkbox" name="debug" id="debug" <?php echo $this->getVariable('DEBUG_CHECKED', ''); ?>>
                    <label for="debug"><?php echo $this->escape($this->getVariable('TR_DEBUG', 'Debug mode')); ?></label>
                    <small><?php echo $this->escape($this->getVariable('TR_DEBUG_DESCRIPTION', '')); ?></small>
                </div>
                
                <div class="form-group checkbox-group">
                    <input type="checkbox" name="enable_for_clients" id="enable_for_clients" <?php echo $this->getVariable('CLIENTS_CHECKED', ''); ?>>
                    <label for="enable_for_clients"><?php echo $this->escape($this->getVariable('TR_ENABLE_FOR_CLIENTS', 'Enable for clients')); ?></label>
                </div>
                
                <div class="form-group checkbox-group">
                    <input type="checkbox" name="enable_for_resellers" id="enable_for_resellers" <?php echo $this->getVariable('RESELLERS_CHECKED', 'checked'); ?>>
                    <label for="enable_for_resellers"><?php echo $this->escape($this->getVariable('TR_ENABLE_FOR_RESELLERS', 'Enable for resellers')); ?></label>
                </div>
            </div>
            
            <button type="submit" name="save_settings" class="btn btn-primary">
                <?php echo $this->escape($this->getVariable('TR_SAVE', 'Save')); ?>
            </button>
            <button type="button" class="btn btn-secondary" onclick="window.history.back();">
                <?php echo $this->escape($this->getVariable('TR_CANCEL', 'Cancel')); ?>
            </button>
        </form>
    </div>
</body>
</html>
