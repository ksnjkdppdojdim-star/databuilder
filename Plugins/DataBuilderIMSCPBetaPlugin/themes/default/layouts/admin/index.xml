<?xml version="1.0" encoding="UTF-8"?>
<!--
    DataBuilder Admin Index Layout
    Defines the page structure with blocks for admin index page
-->
<layout>
    <!-- Root container -->
    <block name="page_root" class="DataBuilder\Block\Container">
        <params>
            <param name="class">databuilder-admin-index</param>
        </params>
        <children>
            <!-- Stats Grid Container -->
            <block name="stats_grid" class="DataBuilder\Block\Container">
                <params>
                    <param name="class">grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-6</param>
                </params>
                <children>
                    <!-- Admin Users -->
                    <block name="admin_users_stat" template="blocks/stat_card.phtml">
                        <params>
                            <param name="label">{TR_ADMIN_USERS}</param>
                            <param name="value">{ADMIN_USERS}</param>
                            <param name="icon">admin_panel_settings</param>
                            <param name="color">blue</param>
                            <param name="span">2</param>
                        </params>
                    </block>
                    
                    <!-- Reseller Users -->
                    <block name="reseller_users_stat" template="blocks/stat_card.phtml">
                        <params>
                            <param name="label">{TR_RESELLER_USERS}</param>
                            <param name="value">{RESELLER_USERS}</param>
                            <param name="icon">store</param>
                            <param name="color">emerald</param>
                            <param name="span">2</param>
                        </params>
                    </block>
                    
                    <!-- Normal Users -->
                    <block name="normal_users_stat" template="blocks/stat_card.phtml">
                        <params>
                            <param name="label">{TR_NORMAL_USERS}</param>
                            <param name="value">{NORMAL_USERS}</param>
                            <param name="icon">people</param>
                            <param name="color">amber</param>
                            <param name="span">2</param>
                        </params>
                    </block>
                    
                    <!-- Domains -->
                    <block name="domains_stat" template="blocks/stat_card.phtml">
                        <params>
                            <param name="label">{TR_DOMAINS}</param>
                            <param name="value">{DOMAINS}</param>
                            <param name="icon">language</param>
                            <param name="color">purple</param>
                            <param name="span">2</param>
                        </params>
                    </block>
                    
                    <!-- FTP Accounts -->
                    <block name="ftp_accounts_stat" template="blocks/stat_card.phtml">
                        <params>
                            <param name="label">{TR_FTP_ACCOUNTS}</param>
                            <param name="value">{FTP_ACCOUNTS}</param>
                            <param name="icon">folder_open</param>
                            <param name="color">cyan</param>
                            <param name="span">2</param>
                        </params>
                    </block>
                    
                    <!-- SQL Databases -->
                    <block name="sql_databases_stat" template="blocks/stat_card.phtml">
                        <params>
                            <param name="label">{TR_SQL_DATABASES}</param>
                            <param name="value">{SQL_DATABASES}</param>
                            <param name="icon">database</param>
                            <param name="color">indigo</param>
                            <param name="span">2</param>
                        </params>
                    </block>
                    
                    <!-- SQL Users -->
                    <block name="sql_users_stat" template="blocks/stat_card.phtml">
                        <params>
                            <param name="label">{TR_SQL_USERS}</param>
                            <param name="value">{SQL_USERS}</param>
                            <param name="icon">manage_accounts</param>
                            <param name="color">orange</param>
                            <param name="span">2</param>
                        </params>
                    </block>
                    
                    <!-- Mail Accounts -->
                    <block name="mail_accounts_stat" template="blocks/stat_card.phtml">
                        <params>
                            <param name="label">{TR_MAIL_ACCOUNTS}</param>
                            <param name="value">{MAIL_ACCOUNTS}</param>
                            <param name="icon">mail</param>
                            <param name="color">red</param>
                            <param name="span">4</param>
                        </params>
                    </block>
                </children>
            </block>
            
            <!-- Traffic Section -->
            <block name="traffic_section" template="blocks/traffic_bar.phtml">
                <params>
                    <param name="title">{TR_SERVER_TRAFFIC}</param>
                    <param name="warning">{TRAFFIC_WARNING}</param>
                    <param name="percent_width">{TRAFFIC_PERCENT_WIDTH}</param>
                    <param name="percent">{TRAFFIC_PERCENT}</param>
                </params>
            </block>
        </children>
    </block>
</layout>

