<?php
/**
 * Admin > Layout — Sélecteur de thème et de couleur
 *
 * @var \DataBuilder\Block\ContainerBlock $block
 */
$trLayout      = $block->getData('tr_layout',              'Layout');
$trChoose      = $block->getData('tr_choose_layout',       'Choose layout');
$trChooseColor = $block->getData('tr_choose_layout_color', 'Choose layout color');
$trUpdate      = $block->getData('tr_update',              'Update');
$selectedTheme = $block->getData('selected_theme', '');
$selectedColor = $block->getData('selected_color', '');
$themes        = $block->getData('themes', []);
$colors        = $block->getData('colors', []);
$themesJson    = $block->getData('themes_data_json', '{}');

$esc = fn(string $s): string => htmlspecialchars($s, ENT_QUOTES, 'UTF-8');
?>
<script>
var dbThemes = <?= $themesJson ?>;
document.addEventListener('DOMContentLoaded', function () {
    var themeSelect = document.getElementById('db-theme');
    var colorSelect = document.getElementById('db-layoutColor');
    if (!themeSelect || !colorSelect) return;
    themeSelect.addEventListener('change', function () {
        var opts = dbThemes[this.value] || {};
        colorSelect.innerHTML = '';
        Object.keys(opts).forEach(function (label) {
            var opt = document.createElement('option');
            opt.value = opts[label];
            opt.textContent = label;
            colorSelect.appendChild(opt);
        });
    });
});
</script>

<div class="db-card">
    <div class="db-card-header">
        <h2><?= $esc($trLayout) ?></h2>
    </div>
    <div class="db-card-body">
        <form class="db-form" method="post" action="layout.php">
            <div class="db-form-row">
                <label for="db-theme"><?= $esc($trChoose) ?></label>
                <select name="theme" id="db-theme">
                    <?php foreach ($themes as $theme): ?>
                        <option value="<?= $esc($theme) ?>"<?= $theme === $selectedTheme ? ' selected' : '' ?>>
                            <?= $esc($theme) ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </div>

            <div class="db-form-row">
                <label for="db-layoutColor"><?= $esc($trChooseColor) ?></label>
                <select name="layoutColor" id="db-layoutColor">
                    <?php foreach ($colors as $color): ?>
                        <?php $label = ($color === '_none_') ? 'default' : $color; ?>
                        <option value="<?= $esc($color) ?>"<?= $color === $selectedColor ? ' selected' : '' ?>>
                            <?= $esc($label) ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </div>

            <div class="db-form-actions">
                <input type="hidden" name="uaction" value="changeLayoutColor">
                <button type="submit" class="db-btn db-btn-primary">
                    <?= $esc($trUpdate) ?>
                </button>
            </div>
        </form>
    </div>
</div>
