<script>
window.themeDefaultPageConfig = window.themeDefaultPageConfig || {};
window.themeDefaultPageConfig.databuilder = {
    saveSuccess: "<?= tojs(tr('Settings saved successfully.')); ?>",
    saveError: "<?= tojs(tr('Failed to save settings.')); ?>"
};

document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('databuilder_frm');
    if (form) {
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            
            const formData = new FormData(form);
            
            fetch('databuilder.php?action=save', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.message) {
                    alert(data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert(window.themeDefaultPageConfig.databuilder.saveError);
            });
        });
    }
});
</script>
