<script>
/**
 * DataBuilder Admin Index - Interactivity
 * 
 * This script is optional and can be completely overridden
 * in themes/custom/templates/admin/index.phtml
 */

(function() {
    'use strict';
    
    document.addEventListener('DOMContentLoaded', function() {
        initializeStatCards();
    });
    
    /**
     * Initialize stat card interactions
     */
    function initializeStatCards() {
        const cards = document.querySelectorAll('[data-stat]');
        
        cards.forEach((card) => {
            card.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-2px)';
            });
            
            card.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0)';
            });
        });
    }
})();
</script>
