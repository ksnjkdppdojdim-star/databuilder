<script>
function insertTag(tag) {
    const textarea = document.getElementById('content');
    const start = textarea.selectionStart;
    const end = textarea.selectionEnd;
    const text = textarea.value;
    const selected = text.substring(start, end);
    
    let newText;
    if (tag === 'img') {
        newText = text.substring(0, start) + '<img src="" alt="">' + text.substring(end);
    } else if (tag === 'a') {
        newText = text.substring(0, start) + '<a href="">' + (selected || 'link text') + '</a>' + text.substring(end);
    } else {
        newText = text.substring(0, start) + '<' + tag + '>' + (selected || 'content') + '</' + tag + '>' + text.substring(end);
    }
    
    textarea.value = newText;
    textarea.focus();
}

// Auto-generate URL key from title
document.getElementById('title').addEventListener('input', function() {
    const urlKeyInput = document.getElementById('url_key');
    if (!urlKeyInput.dataset.modified) {
        const slug = this.value.toLowerCase()
            .replace(/[^a-z0-9\s-]/g, '')
            .replace(/\s+/g, '-')
            .replace(/-+/g, '-')
            .trim();
        urlKeyInput.value = slug;
    }
});

document.getElementById('url_key').addEventListener('input', function() {
    this.dataset.modified = 'true';
});
</script>
